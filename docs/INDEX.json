  "glossary": {
    "MJ": {
      "meaning": "Master Journal",
      "description": "cross-project chronology, constitutional rules, shared architecture decisions and concise traceable summaries.",
      "status": "VERIFIED",
      "source": "https://github.com/aoblak/https-github.com-aoblak-self-improving-ai-agent-sdk/blob/a165ad489a34c8def8f8bd819d4fa35d3bec0d88/docs/governance/GLOSSARY.md"
    },
    "PJ": {
      "meaning": "Project Journal",
      "description": "detailed dated project-level decisions, implementation, tests, results, evidence, risks and next actions.",
      "status": "VERIFIED",
      "source": "https://github.com/aoblak/https-github.com-aoblak-self-improving-ai-agent-sdk/blob/a165ad489a34c8def8f8bd819d4fa35d3bec0d88/docs/governance/GLOSSARY.md"
    },
    "XJ": {
      "meaning": "Cross-Journal / Cross-Source Check",
      "description": "inspect all materially related journals and authoritative sources before consequential decisions or promotion.",
      "status": "VERIFIED",
      "source": "https://github.com/aoblak/https-github.com-aoblak-self-improving-ai-agent-sdk/blob/a165ad489a34c8def8f8bd819d4fa35d3bec0d88/docs/governance/GLOSSARY.md"
    },
    "SOT": {
      "meaning": "Source of Truth",
      "description": "type-specific authoritative source for a fact.",
      "status": "VERIFIED",
      "source": "https://github.com/aoblak/https-github.com-aoblak-self-improving-ai-agent-sdk/blob/a165ad489a34c8def8f8bd819d4fa35d3bec0d88/docs/governance/GLOSSARY.md"
    },
    "UM": {
      "meaning": "Unified Memory update with verification",
      "description": "review current context and related evidence, then retain only durable, verified decisions/corrections/open items without unnecessary duplication. UM is not permission to override higher-authority repo/provider evidence.",
      "status": "VERIFIED",
      "source": "https://github.com/aoblak/https-github.com-aoblak-self-improving-ai-agent-sdk/blob/a165ad489a34c8def8f8bd819d4fa35d3bec0d88/docs/governance/GLOSSARY.md"
    },
    "FMU": {
      "meaning": "Folder Memory Update",
      "description": "update the durable memory/journal representation associated with a scoped project/folder after verification; preserve provenance and avoid duplicate authority.",
      "status": "VERIFIED",
      "source": "https://github.com/aoblak/https-github.com-aoblak-self-improving-ai-agent-sdk/blob/a165ad489a34c8def8f8bd819d4fa35d3bec0d88/docs/governance/GLOSSARY.md"
    },
    "GS": {
      "meaning": "Git State",
      "description": "report the relevant repository/branch, working tree when observable, latest commit, changed/uncommitted files when observable, ahead/behind or remote sync when observable, and relevant open PR/issues if available. Clearly separate confirmed from unavailable/unknown state.",
      "status": "VERIFIED",
      "source": "https://github.com/aoblak/https-github.com-aoblak-self-improving-ai-agent-sdk/blob/a165ad489a34c8def8f8bd819d4fa35d3bec0d88/docs/governance/GLOSSARY.md"
    },
    "NEEDS-REVIEW": {
      "meaning": "Unresolved or conflicting evidence",
      "status": "VERIFIED",
      "source": "OOS Context Protocol 0.1.0"
    },
    "UNKNOWN": {
      "meaning": "Required information is unavailable",
      "status": "VERIFIED",
      "source": "OOS Context Protocol 0.1.0"
    }
  },
